/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/contact
  Cache-Control: public, max-age=0, must-revalidate

/contact/
  Cache-Control: public, max-age=0, must-revalidate

/about
  Cache-Control: public, max-age=0, must-revalidate

/about/
  Cache-Control: public, max-age=0, must-revalidate

/media/*
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/projects
  Cache-Control: public, max-age=0, must-revalidate

/projects/
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: no-store

# scripts/verify-build.mjs appends immutable rules for emitted hashed assets only.
# Do not use /assets/*: it would also cache missing-asset error responses.
