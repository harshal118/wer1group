# Cloudflare Pages deploys this repository root directly.
# HTML: keep cached copies, but revalidate before reuse.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JavaScript filenames are stable across deployments, not content-hashed.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Stable image URLs: modest freshness lifetime, never immutable.
/assets/images/*
  Cache-Control: public, max-age=3600, must-revalidate

/public/images/*
  Cache-Control: public, max-age=3600, must-revalidate
